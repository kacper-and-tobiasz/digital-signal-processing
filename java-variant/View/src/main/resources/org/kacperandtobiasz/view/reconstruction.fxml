<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>

<SplitPane disable="true" dividerPositions="0.4" prefWidth="1000.0"
           xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.kacperandtobiasz.view.controllers.reconstruction.ReconstructionController"
    >
<items>
    <AnchorPane maxWidth="400.0" minWidth="400.0" SplitPane.resizableWithParent="false">
        <children>
            <Accordion prefHeight="694.4" prefWidth="400.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <panes>
                <TitledPane animated="false" text="Kwantyzacja i rekonstrukcja">
                    <content>
                        <fx:include source="reconstruction/reconstruction_settings.fxml" fx:id="reconstructionSettings" />
                    </content>
                </TitledPane>
            </panes>
            </Accordion>
        </children>
    </AnchorPane>
    <AnchorPane minHeight="0.0" minWidth="0.0">
        <children>
            <fx:include source="reconstruction/reconstruction_charts.fxml" fx:id="reconstructionCharts" />
        </children>
    </AnchorPane>
</items>
</SplitPane>
