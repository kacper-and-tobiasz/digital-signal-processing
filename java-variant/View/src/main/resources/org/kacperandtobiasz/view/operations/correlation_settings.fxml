<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.kacperandtobiasz.view.controllers.operations.CorrelationController" minHeight="0.0" minWidth="0.0">
    <children>
        <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
            <children>
                <GridPane maxWidth="1.7976931348623157E308">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="187.0" minWidth="10.0" prefWidth="176.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" prefWidth="187.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                        <RowConstraints vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label maxWidth="1.7976931348623157E308" text="Korelacja sygnałów" textOverrun="WORD_ELLIPSIS" GridPane.columnSpan="2">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                            <GridPane.margin>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="16.0" />
                            </GridPane.margin>
                        </Label>
                        <Label text="Sygnał 1:" GridPane.rowIndex="1" />
                        <ComboBox fx:id="firstSignalSelectorComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Sygnał 2:" GridPane.rowIndex="2" />
                        <ComboBox fx:id="secondSignalSelectorComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Sygnał wynikowy:" GridPane.rowIndex="3" />
                        <ComboBox fx:id="resultSignalSelectorComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Metoda:" GridPane.rowIndex="4" />
                        <ComboBox fx:id="correlationMethodComboBox" maxWidth="1.7976931348623157E308" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                </GridPane>
                <Button fx:id="calculateButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCalculateCorrelation" text="Oblicz korelację">
                    <VBox.margin>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </children>
</AnchorPane>
